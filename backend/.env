# Docalypt LLM configuration
DOCALYPT_LLM_PROVIDER=ollama
DOCALYPT_LLM_MODEL=llama3
DOCALYPT_LLM_ENDPOINT=http://localhost:11434

# Optional path overrides (absolute or relative to the process working directory)
# DOCALYPT_TRANSCRIPTS_DIR=
# DOCALYPT_GENERATED_DIR=
# DOCALYPT_PROMPTS_DIR=

# CORS and local folder access
DOCALYPT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI-compatible providers
DOCALYPT_OPENAI_API_KEY=
DOCALYPT_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude providers
DOCALYPT_ANTHROPIC_API_KEY=
DOCALYPT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DOCALYPT_ANTHROPIC_VERSION=2023-06-01
